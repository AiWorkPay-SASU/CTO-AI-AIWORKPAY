# Copy to .env (git-ignored) and load it: set -a; . ./.env; set +a; npm start
CTO_ADMIN_TOKEN=            # 24+ chars, required (owner). Open Cortex uses it as CORTEX_CTO_TOKEN.
# CTO_VIEWER_TOKEN=         # optional read-only token, must differ
CTO_REPO_PATH=              # absolute path of the checkout the agents work on (must equal the Open Cortex project path)
# CTO_DATA_DIR=.cto-data
# CTO_WORKSPACES_DIR=
# PORT=3000
# HOST=127.0.0.1
# CTO_PREFLIGHT=1           # never set to 0 in real use: it disables the runtime isolation check
